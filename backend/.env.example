# Backend environment configuration for SAP EWA Analyzer (Docker)
# Copy this file to .env and fill in your values.

# --- REQUIRED: Azure Blob Storage (used for uploads and outputs) ---
AZURE_STORAGE_CONNECTION_STRING=<set-in-secret-store>
AZURE_STORAGE_CONTAINER_NAME=earlywatch

# --- AZURE OPENAI CONFIGURATION ---
# Provide your Azure OpenAI resource credentials and a deployment name.
AZURE_OPENAI_API_KEY=<set-in-secret-store>
AZURE_OPENAI_ENDPOINT=<set-in-secret-store>
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# --- REQUIRED: INDEPENDENT MODEL DEPLOYMENTS ---
ORCHESTRATOR_MODEL=<your-orchestrator-deployment>
SPECIALIST_MODEL=<your-specialist-deployment>
CHAT_MODEL=<your-chat-deployment>
# Optional downstream settings; blank inherits the corresponding planner setting.
CROSS_REFERENCE_MODEL=
CROSS_REFERENCE_REASONING_EFFORT=
SYNTHESIS_MODEL=
SYNTHESIS_REASONING_EFFORT=
SPECIALIST_REASONING_EFFORT=
REQUEST_TIMEOUT_SECONDS=180
PLANNING_TIMEOUT_SECONDS=
MAX_CONCURRENCY=4
MAX_TASK_SECTIONS=12
MAX_TASK_CONTENT_CHARS=48000
MAX_PARENT_CONTEXT_CHARS=4000

# --- DECISION-1 ALERT MATCHING (optional; OFF unless DECISION_ENABLED=true) ---
# Uses Microsoft Decision-1 on the same Azure endpoint to match SAP alerts to our findings
# in the "SAP vs Us" sheet. Adds about 500 small calls per report. Defaults shown.
# DECISION_ENABLED=true
# DECISION_MODEL=Decision-1
# DECISION_KEEP=0.85
# DECISION_POSSIBLE=0.5
# DECISION_WORKERS=8
# DECISION_BUDGET_SECONDS=300

# --- REQUIRED: MODEL REASONING EFFORTS ---
# Supported values: none, low, medium, high, xhigh, max
# DEEP_REASONING_EFFORT controls the specialist/domain-analysis model.
CHAT_REASONING_EFFORT=medium
ORCHESTRATOR_REASONING_EFFORT=medium
DEEP_REASONING_EFFORT=high

# --- CHAT ENDPOINT TUNING (optional; defaults shown) ---
CHAT_HISTORY_LIMIT=10
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_NODE_CANDIDATE_LIMIT=6
CHAT_NODE_CONTEXT_CHARS=45000
CHAT_NODE_TEXT_SCAN_CHARS=2000

# --- CLAUDE ON AZURE AI FOUNDRY (optional; nothing changes if these are unset) ---
# Each role uses Azure OpenAI unless you switch it to Claude here. Put the Claude
# deployment name (for example claude-sonnet-5-5) in that role's *_MODEL / CHAT_MODEL.
# Azure OpenAI settings above are still required (Decision-1 uses them).
# Values: azure_openai (default) or foundry_claude
# ORCHESTRATOR_PROVIDER=azure_openai
# SPECIALIST_PROVIDER=azure_openai
# CROSS_REFERENCE_PROVIDER and SYNTHESIS_PROVIDER default to: azure_openai if the role has its
# own *_MODEL, otherwise the orchestrator's provider.
# CROSS_REFERENCE_PROVIDER=
# SYNTHESIS_PROVIDER=
# CHAT_PROVIDER=azure_openai
# Raise CHAT_MAX_OUTPUT_TOKENS above if chat uses Claude with thinking on (thinking counts toward it).
AZURE_ANTHROPIC_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
AZURE_ANTHROPIC_API_KEY=<set-in-secret-store>
# Maximum answer length for Claude analysis calls (thinking counts toward it).
# ANTHROPIC_MAX_OUTPUT_TOKENS=32000

# --- OPTIONAL ---
# Ensures logs flush immediately
PYTHONUNBUFFERED=1
ENVIRONMENT=production
AUTH_ENABLED=false
TRUST_PLATFORM_AUTH_HEADERS=false

# Direct JWT validation settings (used when the frontend sends bearer tokens)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ISSUER=

# Container Apps built-in auth + same-origin hosting normally do not need CORS.
CORS_ALLOWED_ORIGINS=
