# Backend environment configuration for SAP EWA Analyzer (Docker)
# Copy this file to .env and fill in your values.

# --- REQUIRED: Azure Blob Storage (used for uploads and outputs) ---
AZURE_STORAGE_CONNECTION_STRING=<set-in-secret-store>
AZURE_STORAGE_CONTAINER_NAME=earlywatch

# --- PROVIDER SELECTION ---
# Controls which AI provider is used for the summary step.
# Values: "openai" (default) or "anthropic"
PROVIDER=openai

# --- AZURE OPENAI CONFIGURATION (used when PROVIDER=openai) ---
# Provide your Azure OpenAI resource credentials and a deployment name.
AZURE_OPENAI_API_KEY=<set-in-secret-store>
AZURE_OPENAI_ENDPOINT=<set-in-secret-store>
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Optional legacy summary setting; document chat uses CHAT_MODEL below.
AZURE_OPENAI_SUMMARY_MODEL=<your-deployment-name>

# --- REQUIRED: INDEPENDENT MODEL DEPLOYMENTS ---
ORCHESTRATOR_MODEL=<your-orchestrator-deployment>
SPECIALIST_MODEL=<your-specialist-deployment>
CHAT_MODEL=<your-chat-deployment>
# Optional downstream settings; blank inherits the corresponding planner setting.
CROSS_REFERENCE_MODEL=
CROSS_REFERENCE_REASONING_EFFORT=
SYNTHESIS_MODEL=
SYNTHESIS_REASONING_EFFORT=
SPECIALIST_REASONING_EFFORT=
REQUEST_TIMEOUT_SECONDS=180
PLANNING_TIMEOUT_SECONDS=
MAX_CONCURRENCY=4
MAX_TASK_SECTIONS=12
MAX_TASK_CONTENT_CHARS=48000
MAX_PARENT_CONTEXT_CHARS=4000

# --- REQUIRED: MODEL REASONING EFFORTS ---
# Supported values: none, low, medium, high, xhigh, max
# DEEP_REASONING_EFFORT controls the specialist/domain-analysis model.
CHAT_REASONING_EFFORT=medium
ORCHESTRATOR_REASONING_EFFORT=medium
DEEP_REASONING_EFFORT=high

# --- CHAT ENDPOINT TUNING (optional; defaults shown) ---
CHAT_HISTORY_LIMIT=10
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_NODE_CANDIDATE_LIMIT=6
CHAT_NODE_CONTEXT_CHARS=45000
CHAT_NODE_TEXT_SCAN_CHARS=2000

# --- AZURE AI FOUNDRY / ANTHROPIC CONFIGURATION (used when PROVIDER=anthropic) ---
# Provide your Azure AI Foundry endpoint and API key for Claude models.
# Model options: claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-1
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-4-5
AZURE_ANTHROPIC_ENDPOINT=<optional-secret-store-value>
AZURE_ANTHROPIC_API_KEY=<optional-secret-store-value>
ANTHROPIC_MAX_OUTPUT_TOKENS=32768
ANTHROPIC_THINKING_BUDGET_TOKENS=0

# --- OPTIONAL ---
# Ensures logs flush immediately
PYTHONUNBUFFERED=1
ENVIRONMENT=production
AUTH_ENABLED=false
TRUST_PLATFORM_AUTH_HEADERS=false

# Direct JWT validation settings (used when the frontend sends bearer tokens)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ISSUER=

# Container Apps built-in auth + same-origin hosting normally do not need CORS.
CORS_ALLOWED_ORIGINS=
