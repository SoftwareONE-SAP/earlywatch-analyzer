# Backend runtime settings. Do not put real values in this file.
PROVIDER=openai

AZURE_STORAGE_CONNECTION_STRING=<set-in-secret-store>
AZURE_STORAGE_CONTAINER_NAME=earlywatch

AZURE_OPENAI_ENDPOINT=<set-in-secret-store>
AZURE_OPENAI_API_KEY=<set-in-secret-store>
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_SUMMARY_MODEL=gpt-5.4-mini
AZURE_OPENAI_PARAM_MODEL=gpt-5.4-mini
AZURE_OPENAI_FAST_MODEL=gpt-5.4-mini
AZURE_OPENAI_CHAT_MODEL=gpt-5.4-mini

V2_ROUTER_MODEL=gpt-5.4-nano
V2_ORCHESTRATOR_MODEL=gpt-5.4
V2_SPECIALIST_MODEL=gpt-5.4-mini
V2_DEEP_MODEL=gpt-5.4
V2_SPECIALIST_MAX_TOKENS=16384
V2_DEEP_MAX_TOKENS=16384
V2_SPECIALIST_REASONING=none
V2_DEEP_REASONING=medium

# --- REQUIRED: MODEL REASONING EFFORTS ---
# Supported values: none, low, medium, high, xhigh, max
# DEEP_REASONING_EFFORT controls the specialist/domain-analysis model.
CHAT_REASONING_EFFORT=medium
ORCHESTRATOR_REASONING_EFFORT=medium
DEEP_REASONING_EFFORT=medium

# Optional CLI-compatible analysis overrides. Blank deployment/effort inherits
# the corresponding V2 setting; cross-reference and synthesis inherit planner.
ORCHESTRATOR_MODEL=
SPECIALIST_MODEL=
SPECIALIST_REASONING_EFFORT=
CROSS_REFERENCE_MODEL=
CROSS_REFERENCE_REASONING_EFFORT=
SYNTHESIS_MODEL=
SYNTHESIS_REASONING_EFFORT=
# Positive integers. Blank planning timeout inherits the request timeout.
REQUEST_TIMEOUT_SECONDS=180
PLANNING_TIMEOUT_SECONDS=
MAX_CONCURRENCY=4
MAX_TASK_SECTIONS=12
MAX_TASK_CONTENT_CHARS=48000
MAX_PARENT_CONTEXT_CHARS=4000

# --- CHAT ENDPOINT TUNING (optional; defaults shown) ---
CHAT_HISTORY_LIMIT=10
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_NODE_CANDIDATE_LIMIT=6
CHAT_NODE_CONTEXT_CHARS=45000
CHAT_NODE_TEXT_SCAN_CHARS=2000

SUMMARY_REASONING_EFFORT=none
PARAM_REASONING_EFFORT=none

# Optional Anthropic-on-Azure settings
ANTHROPIC_SUMMARY_MODEL=
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
V2_ANTHROPIC_ROUTER_MODEL=claude-haiku-4.5
V2_ANTHROPIC_SPECIALIST_MODEL=claude-haiku-4.5
V2_ANTHROPIC_DEEP_MODEL=claude-sonnet-4.6
ANTHROPIC_MAX_OUTPUT_TOKENS=32768
ANTHROPIC_THINKING_BUDGET_TOKENS=0

ENVIRONMENT=production
AUTH_ENABLED=false
CORS_ALLOWED_ORIGINS=
